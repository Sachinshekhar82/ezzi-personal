# ===================================================================
# AI Keys Configuration (Hybrid Dual-Engine Architecture)
# ===================================================================

# 1. Groq API: Used for ULTRA-FAST (<1 sec) Spoken Audio / Zoom Questions
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API: Used for Screen Captures & Multimodal Vision Code
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_MODEL=gemini-2.5-flash

# Self-hosted direct LLM mode
VITE_SELF_HOSTED_MODE=true
IS_MOCK=false
